# ==============================================================================
# MULTIVERUS — Configuration d'environnement (Backend)
# ==============================================================================

# ─── 1. BASE DE DONNÉES (PostgreSQL & Pooling) ────────────────────────────────
# En local : postgresql://user:password@localhost:5432/dbname
# En Serverless (Neon / Supabase) : utiliser l'URL du pooler (port 6543 ou host -pooler)
DATABASE_URL="postgresql://user:password@localhost:5432/bzt_db"
# Taille maximale du pool (10 par défaut, ajuster selon la limite du pooler)
PG_MAX_POOL_SIZE=10

# ─── 2. SERVEUR & ENVIRONNEMENT ───────────────────────────────────────────────
PORT=8080
NODE_ENV=development # development | production | test

# URLs Frontend pour CORS (séparées par une virgule si plusieurs frontends)
# Ex : https://multiverus.com,https://admin.multiverus.com,https://mon-app.vercel.app
FRONTEND_URL=http://localhost:3000,http://localhost:5173
# Autoriser automatiquement les déploiements de prévisualisation Vercel (*.vercel.app)
ALLOW_VERCEL_PREVIEWS=true

# ─── 3. STOCKAGE MÉDIAS (S3 / Cloudflare R2 / Local) ──────────────────────────
# Pour Vercel : activer Cloudflare R2 ou AWS S3 pour contourner la limite de 4.5 Mo
# Laisser vide pour utiliser le stockage local (dossier ./uploads sur VPS/dev)
S3_BUCKET_NAME=
S3_REGION=auto # 'auto' pour Cloudflare R2, ou région AWS (ex: eu-west-3)
S3_ENDPOINT=   # Ex R2 : https://<ACCOUNT_ID>.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL= # Ex CDN : https://pub-xxx.r2.dev ou https://cdn.multiverus.com
S3_FORCE_PATH_STYLE=false # true pour MinIO / LocalStack

# Stockage local fallback (utilisé si S3_* n'est pas configuré)
MEDIA_STORAGE_PATH=./uploads
MEDIA_BASE_URL=http://localhost:8080

# ─── 4. SÉCURITÉ & AUTHENTIFICATION (JWT, CSRF, COOKIES) ─────────────────────
# Générer des clés fortes avec: openssl rand -hex 64
JWT_ACCESS_SECRET=changer_avec_cle_secrete_jwt_access_tres_longue_123456789
JWT_REFRESH_SECRET=changer_avec_cle_secrete_jwt_refresh_tres_longue_123456789
CSRF_SECRET=changer_avec_cle_secrete_csrf_tres_longue_123456789
COOKIE_SECRET=changer_avec_cle_secrete_cookie_tres_longue_123456789

# Options Cookies pour HTTPS multi-domaines (Vercel / Netlify)
# En dev : 'Lax'. En prod multi-domaines sans même apex : 'None'.
COOKIE_SAMESITE=Lax
# Domaine partagé pour les cookies (ex: '.multiverus.com' si API et frontends partagent ce domaine)
COOKIE_DOMAIN=

# ─── 5. VERCEL CRON JOBS ──────────────────────────────────────────────────────
# Clé secrète transmise par Vercel Cron dans le header 'Authorization: Bearer <CRON_SECRET>'
CRON_SECRET=changer_avec_cle_secrete_cron_longue_aleatoire_123456789

# ─── 6. EMAIL (Nodemailer SMTP) ───────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=contact@multiverus.com
SMTP_PASS=mot_de_passe_app
SMTP_FROM="MultiVerus <contact@multiverus.com>"
